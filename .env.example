# Anthropic API
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Token protecting the server's deployed evaluation route. Use a long random
# value and configure the same value as EVAL_RUN_TOKEN when invoking evals.
UK_CHAT_EVAL_TOKEN=replace_with_a_long_random_token

# PolicyEngine UK data (required for economy-wide simulations)
HUGGING_FACE_TOKEN=your_token_here

# Backend URL used by the Next.js proxy route
BACKEND_URL=http://localhost:8001
EVAL_BACKEND_URL=http://localhost:8001
EVAL_RUN_TOKEN=replace_with_the_same_eval_token
POLICYENGINE_UK_CHAT_EVAL_MODAL_APP_NAME=policyengine-uk-chat-evals
POLICYENGINE_UK_CHAT_EVAL_MODAL_SECRET_NAME=policyengine-uk-chat-secrets
POLICYENGINE_UK_CHAT_EVAL_MODAL_VOLUME_NAME=policyengine-uk-chat-eval-reports

# Optional direct browser override for backend requests
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

APP_URL=http://localhost:3000
GITHUB_REPORT_REPO=PolicyEngine/policyengine-uk-chat

# Billing is opt-in. Backend Supabase and Stripe credentials are ignored while false.
BILLING_ENABLED=false
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_backend_secret_key
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Database
DB_NAME=microsim
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Supabase (frontend auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
